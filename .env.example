# Google Gemini API Key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter API Key from https://openrouter.ai/ (Fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Groq API Key from https://console.groq.com/ (Fallback 2)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Backend microservice URLs
USER_SERVICE_URL=http://localhost:8081
CLINIC_SERVICE_URL=http://localhost:8082
QUEUE_SERVICE_URL=http://localhost:8085
CONSULTATION_SERVICE_URL=http://localhost:8086
MEDICAL_RECORDS_SERVICE_URL=http://localhost:8087

# Chatbot server port
CHATBOT_PORT=8091
